# ArqAI cron environment file.
# Copy to /etc/arq/cron.env on the VPS, fill in the secret, then chmod 600.
#   sudo mkdir -p /etc/arq
#   sudo cp scripts/cron.env.example /etc/arq/cron.env
#   sudo nano /etc/arq/cron.env      # set CRON_SECRET
#   sudo chmod 600 /etc/arq/cron.env

# Must match CRON_SECRET in the app's runtime environment.
CRON_SECRET=

# Optional. Defaults to https://thearq.ai if omitted.
ARQ_BASE_URL=https://thearq.ai
